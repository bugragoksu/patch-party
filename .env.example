# Patch Party: tek yapılandırma dosyası
#
# Kullanım:
#   cp .env.example .env.staging   (staging ortamı)
#   cp .env.example .env.prod      (prod ortamı)
# Gerçek değerler yalnızca bu kopyalara yazılır. .env.staging ve .env.prod git'e girmez.
# Bu şablon dosyası (.env.example) herkese açık repoda durur: buraya gerçek değer yazma.
#
# Kural: APP_ ile başlayan anahtarlar tarayıcıya giden uygulama paketine girer, herkes görebilir.
# Gizli bir değeri ASLA APP_ ile başlatma. Diğer anahtarlar yalnızca sunucu, script ve CI içindir.
# Uygulama paketi bu dosyadan doğrudan değil, yalnızca APP_ anahtarlarını süzen bir script ile beslenir.
#
# Boş bırakılan değerler "henüz bilinmiyor" demek. Deploy öncesi kontrol script'i boş zorunlu alanları listeler.

# --- Ortam -------------------------------------------------------------------
# staging | prod
APP_ENV=staging
# Etkinliğin Firestore kimliği, örn. gdg-adana-2026-10 (küçük harf, rakam, tire)
APP_EVENT_ID=
# Emülatörle yerel geliştirme için true
APP_USE_EMULATOR=false

# --- Firebase (proje) ---------------------------------------------------------
# Firebase proje kimliğin, örn. my-event-staging | my-event-prod (.firebaserc ile aynı)
FIREBASE_PROJECT_ID=
FIREBASE_REGION=europe-west3
# Cloud Functions bölgesi; functions/.env içindeki FUNCTIONS_REGION ile aynı olmalı
APP_FUNCTIONS_REGION=europe-west3
# Public address of the site, for link previews (LinkedIn, X). No trailing
# slash, e.g. https://party.example.com or https://<project>.web.app
SITE_URL=

# --- Firebase web yapılandırması (APP_, gizli değil) --------------------------
# Kaynak: firebase apps:sdkconfig WEB <app-id> --project <proje>
APP_FIREBASE_API_KEY=
APP_FIREBASE_AUTH_DOMAIN=
APP_FIREBASE_PROJECT_ID=
APP_FIREBASE_STORAGE_BUCKET=
APP_FIREBASE_MESSAGING_SENDER_ID=
APP_FIREBASE_APP_ID=
# App Check (reCAPTCHA Enterprise site anahtarı, gizli değil)
APP_RECAPTCHA_SITE_KEY=

# --- Sentry ------------------------------------------------------------------
# DSN gizli değil ama repoda tutulmaz (herkese açık repo, kota kötüye kullanımı)
APP_SENTRY_DSN=
# Source map yükleme için (CI ve yerel script)
SENTRY_ORG=
SENTRY_PROJECT=
# GİZLİ: yalnızca CI secret'ı olarak. Yerelde gerekmedikçe boş bırak
SENTRY_AUTH_TOKEN=

# --- Ekip hesapları (GİZLİ sayılır, APP_ değil) -------------------------------
# Virgülle ayrılmış Google hesapları. tools/set-claims bu listelere custom claim atar.
# En fazla 2 yönetici, hesaplarda 2 adımlı doğrulama zorunlu.
ADMIN_EMAILS=
PROJECTOR_EMAILS=
# Cloud Logging hata uyarıları ve bütçe uyarılarının gideceği adres(ler)
ALERT_EMAILS=

# --- Etkinlik içeriği (ilk kurulumda Firestore'daki etkinlik ayarlarına yazılır) --
# Ürün/etkinlik adı henüz kesin değil. Uygulamada görünen ad buradan gelir.
EVENT_DISPLAY_NAME=Patch Party
EVENT_SUBTITLE=GDG Adana Info Session
# Organizatör: katılım ekranında ve projeksiyonda görünür. Logoyu
# app/assets/brand/organizer.png ile değiştir (koyu zemin için beyaz, ~1440x210).
# Logo yoksa APP_ORGANIZER_LOGO=false. Örnek değerler GDG Adana'ya ait.
APP_ORGANIZER_NAME=GDG Adana
APP_ORGANIZER_LOGO=true
# Oyun süresi (dakika) ve başlangıç (ISO 8601, Europe/Istanbul). Boşsa yönetici elle başlatır
EVENT_LIVE_DURATION_MIN=15
EVENT_LIVE_START_AT=
# Organizasyonun onayladığı ödüller (boş bırakılan gösterilmez)
EVENT_PRIZE_1=
EVENT_PRIZE_2=
EVENT_PRIZE_3=

# --- Oyun ayarları (varsayılanlar, yönetici panelinden de değişir) ------------
GAME_COOLDOWN_SEC=60
GAME_TOKEN_WINDOW_SEC=30
GAME_REQUEST_TTL_SEC=45
GAME_MAX_CONNECTIONS_PER_PLAYER=60
GAME_MAX_PLAYERS=200
GAME_APP_CHECK_ENFORCE=false

# --- Soru havuzu üretimi (yalnızca yerel script) ------------------------------
# GİZLİ: Gemini API anahtarı. Uygulamaya ve CI'a girmez
GEMINI_API_KEY=
GEMINI_MODEL=
